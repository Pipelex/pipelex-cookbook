domain        = "research_report"
description   = "Draft a report on a topic from the model's own knowledge, from three angles, with a second look at each angle's main claim, and compose it in Markdown. No source is searched."
system_prompt = "You are a rigorous research analyst. Cite reasoning and be concise."
main_pipe     = "prepare_report"

# ── Concepts ───────────────────────────────────────────────────────────────

[concept.ResearchQuestion]
description = "A well-formed research question to investigate."
refines     = "Text"

[concept.SourceSummary]
description = "A summary of findings from a single source, framed by an angle."

[concept.SourceSummary.structure]
angle   = { type = "text", description = "The angle or perspective of this source.", required = true }
summary = { type = "text", description = "Concise summary of the source findings.", required = true }

[concept.FactCheck]
description = "A structured fact-check verdict on a source summary."

[concept.FactCheck.structure]
claim = { type = "text", description = "The main claim being evaluated.", required = true }
verdict = { description = "Whether the claim holds up.", choices = [
  "supported",
  "refuted",
  "unverifiable",
], required = true }
confidence = { type = "number", description = "Confidence in the verdict, from 0.0 to 1.0.", required = true }
reasoning = { type = "text", description = "Why this verdict was reached.", required = true }

[concept.ResearchBrief]
description = "A final research brief synthesizing verified sources."

[concept.ResearchBrief.structure]
executive_summary = { type = "text", description = "One-paragraph overview.", required = true }
key_findings      = { type = "list", item_type = "text", description = "Key findings as short bullets.", required = true }
open_questions    = { type = "list", item_type = "text", description = "Questions still open after research.", required = true }

[concept.FormattedReport]
description = "A markdown-formatted report ready for distribution."
refines     = "Text"

# ── Pipes ──────────────────────────────────────────────────────────────────

[pipe.gather_sources]
type = "PipeLLM"
description = "Draft 3 summaries from different angles, out of the model's own knowledge: no source is searched."
inputs = { question = "ResearchQuestion" }
output = "SourceSummary[3]"
prompt = """
Research the question below from 3 different angles. For each angle produce a
SourceSummary with a clear `angle` label and a `summary` paragraph.

Question: $question
"""

[pipe.verify_claim]
type = "PipeLLM"
description = "Look a second time at the main claim of one summary, against the model's own knowledge rather than an independent source."
inputs = { summary = "SourceSummary" }
output = "FactCheck"
prompt = """
Evaluate the main claim in this source. Return a FactCheck with claim,
verdict (supported / refuted / unverifiable), confidence (0.0-1.0), and reasoning.

Angle:   $summary.angle
Summary: $summary.summary
"""

[pipe.synthesize_brief]
type = "PipeLLM"
description = "Synthesize summaries and fact-checks into a final research brief."
inputs = { summaries = "SourceSummary[]", checks = "FactCheck[]" }
output = "ResearchBrief"
prompt = """
Synthesize a research brief from the source summaries and fact-checks below.
Distinguish supported claims from refuted or unverifiable ones.

## Summaries
@summaries

## Fact-checks
@checks

Produce an executive_summary, key_findings, and open_questions.
"""

[pipe.compose_report]
type = "PipeCompose"
description = "Render a deterministic markdown report from the research brief."
inputs = { question = "ResearchQuestion", brief = "ResearchBrief" }
output = "FormattedReport"
template = """
# Research Report

## Question
$question

## Executive Summary
$brief.executive_summary

## Key Findings
{% for finding in brief.key_findings %}- {{ finding }}
{% endfor %}
## Open Questions
{% for item in brief.open_questions %}- {{ item }}
{% endfor %}
---
Generated by Pipelex
"""

[pipe.deep_research]
type = "PipeSequence"
description = "Draft from three angles, look again at each claim, synthesize → typed ResearchBrief."
inputs = { question = "ResearchQuestion" }
output = "ResearchBrief"
steps = [
  { pipe = "gather_sources", result = "summaries" },
  { pipe = "verify_claim", batch_over = "summaries", batch_as = "summary", result = "checks" },
  { pipe = "synthesize_brief", result = "brief" },
]

[pipe.prepare_report]
type = "PipeSequence"
description = "Full pipeline: draft from three angles, look again at each claim, synthesize, format."
inputs = { question = "ResearchQuestion" }
output = "FormattedReport"
steps = [
  { pipe = "gather_sources", result = "summaries" },
  { pipe = "verify_claim", batch_over = "summaries", batch_as = "summary", result = "checks" },
  { pipe = "synthesize_brief", result = "brief" },
  { pipe = "compose_report", result = "report" },
]
