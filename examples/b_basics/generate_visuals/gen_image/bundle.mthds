domain      = "crazy_image_generation"
description = "Imagining and rendering absurd, funny images with unexpected surreal elements"
main_pipe   = "generate_crazy_image"

[concept.SceneConcept]
description = """
A creative, abstract description of an absurd and surreal scene with unexpected element combinations.
"""
refines = "Text"

[concept.ImagePrompt]
description = """
A detailed textual description optimized for image generation models, including subjects, setting, style, and visual details.
"""
refines = "Text"

[pipe.generate_crazy_image]
type = "PipeSequence"
description = """
Main pipeline that orchestrates the full crazy image generation flow - imagines a wild, absurd scene concept, refines it into an image prompt, and renders it as an image
"""
output = "Image"
steps = [
  { pipe = "imagine_scene", result = "scene_concept" },
  { pipe = "generate_img_prompt", result = "image_prompt" },
  { pipe = "render_image", result = "crazy_image" },
]

[pipe.imagine_scene]
type = "PipeLLM"
description = """
Generates a creative, absurd, and hilarious scene concept combining unexpected elements in surreal ways.
"""
output = "SceneConcept"
model = "@default-general"
system_prompt = """
You are a wildly creative visual concept artist specializing in absurd, surreal, and hilarious imagery.
Your task is to generate creative scene concepts that combine unexpected elements in surprising and funny ways.
Think outside the box - the more unexpected the combination, the better!
"""
prompt = """
Generate a creative, absurd, and funny scene concept.
Combine unexpected elements in a surreal way that would make viewers laugh or do a double-take.
Focus on describing the core idea - what elements are combined and why it's funny/absurd.
Keep it brief - just describe the concept, not the full visual details yet.
"""

[pipe.generate_img_prompt]
type = "PipeLLM"
description = """
Transforms the creative scene concept into a detailed, optimized prompt for image generation.
"""
inputs = { scene_concept = "SceneConcept" }
output = "ImagePrompt"
model = "@default-small"
system_prompt = """
You are an expert at crafting prompts for image generation AI models.
"""
prompt = """
Transform this creative scene concept into an optimized image generation prompt:

$scene_concept

Your task is to take a creative concept and transform it into an efficient image generation prompt.
Don't change the ideas, don't add new ideas.
Be concise but descriptive.
Don't include a title, intro or outro, just the prompt.
"""

[pipe.render_image]
type        = "PipeImgGen"
description = "Generates the absurd image based on the creative scene description"
inputs      = { image_prompt = "ImagePrompt" }
output      = "Image"
prompt      = "$image_prompt"
model       = "@default-small"
